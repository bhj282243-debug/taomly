# ══════════════════════════════════════════════════════════════════
# Environment Variables — Restaurant SaaS Platform
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════

# ── DATABASE ───────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or any Postgres)
# sslmode=require is mandatory for Neon
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── SECURITY ───────────────────────────────────────────────────────
# JWT signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-minimum-32-characters-long

# Fernet encryption key for Telegram bot tokens stored in DB
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️  If this key is lost, encrypted bot tokens in the database cannot be recovered.
FERNET_KEY=your-fernet-key-here

# ── SUPERADMIN ─────────────────────────────────────────────────────
# Recommended: use bcrypt hash (SUPERADMIN_PASSWORD_HASH)
# Generate with:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
# Then set the result below:
SUPERADMIN_PASSWORD_HASH=$2b$12$examplehashreplacethiswithyourownbcrypthash

# Alternative (not recommended for production): plain password, auto-hashed on startup with a WARNING
# SUPERADMIN_PASSWORD=your-strong-password-here

# Superadmin login email — change to your own
SUPERADMIN_EMAIL=superadmin@yourdomain.com

# ── PLATFORM BRANDING ──────────────────────────────────────────────
# Shown in PDF invoices and system messages.
# Set to your platform's brand after purchase.
PLATFORM_NAME=My Restaurant Platform
PLATFORM_URL=https://your-platform-domain.com
PLATFORM_EMAIL=billing@your-platform-domain.com

# ── TELEGRAM ───────────────────────────────────────────────────────
# Platform-level bot token (from @BotFather) — optional.
# If set, enables the platform-wide /start flow.
# Each restaurant has its own separate bot token (set via Agency Admin UI).
BOT_TOKEN=1234567890:AAF...

# Base URL where this app is deployed.
# ⚠️  Must be an absolute HTTPS URL with NO path suffix.
#     Correct:   https://your-app.onrender.com
#     Wrong:     https://your-app.onrender.com/webhook   ← do NOT add /webhook
#     Wrong:     https://your-app.onrender.com/app       ← do NOT add /app
# The platform automatically appends:
#   /webhook          → Telegram webhook for platform bot
#   /webhook/{slug}   → Telegram webhook per restaurant
#   /app              → Mini App URL in Telegram buttons
WEBHOOK_URL=https://your-app.onrender.com

# Webhook secret token for request validation (auto-derived from SECRET_KEY if not set)
# Format: [A-Za-z0-9_-], 1–256 chars
# WEBHOOK_SECRET=optional-override

# ── CLOUDFLARE R2 (photo storage) ──────────────────────────────────
# Required for dish photo upload/display. Without it, photos won't work.
# Setup: Cloudflare dashboard → R2 → Create bucket → Create API token (Object Read & Write)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=restaurant-photos
# Public URL for serving files — set up a Custom Domain in R2 Dashboard for production.
# If not set, auto-derived from ACCOUNT_ID and BUCKET_NAME.
# R2_PUBLIC_URL=https://pub.your-domain.com

# ── ENVIRONMENT ────────────────────────────────────────────────────
# Set to "production" on Render.
# In production: ALLOWED_ORIGINS is required or app will not start.
ENVIRONMENT=production

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Required when ENVIRONMENT=production.
ALLOWED_ORIGINS=https://your-app.onrender.com,https://your-domain.com

# ── AI (OPTIONAL) ──────────────────────────────────────────────────
# Disabled by default. All AI endpoints return feature_not_available until enabled.
AI_ENABLED=false
# AI provider: openrouter | openai | anthropic | gemini
AI_PROVIDER=openrouter
# API key for the selected provider
# AI_API_KEY=your-api-key-here
# Model name examples:
#   openrouter:  mistralai/mistral-7b-instruct
#   openai:      gpt-4o-mini
#   anthropic:   claude-sonnet-4-6
#   gemini:      gemini-1.5-flash
AI_MODEL=mistralai/mistral-7b-instruct

# ── OPTIONAL OVERRIDES ─────────────────────────────────────────────
# Error monitoring (Sentry)
# SENTRY_DSN=https://xxx@sentry.io/xxx

# JWT token lifetime in hours (default: 8)
# ACCESS_TOKEN_EXPIRE_HOURS=8

# Telegram initData max age in seconds (default: 3600 = 1 hour)
# MAX_INIT_DATA_AGE_SECONDS=3600

# Rate limiting (defaults shown)
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_API=120/minute
# RATE_LIMIT_SUPERADMIN_LOGIN=5/minute

# Trusted proxy hosts for X-Forwarded-For header.
# "*" = trust any proxy — safe on Render/Railway where app is not exposed directly.
# Use a specific IP if running behind your own nginx.
# TRUSTED_PROXY_HOSTS=*

# ── TEST DATABASE (pytest only) ────────────────────────────────────
# Never use production DATABASE_URL for tests.
# If not set, tests fall back to SQLite in-memory.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/testdb
